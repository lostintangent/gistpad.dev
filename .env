# Env vars prefixed with BUN_PUBLIC_ are inlined into the app by the dev server (`bun dev`).
# Put real values in `.env.local` (gitignored), which overrides this file.

# A GitHub token with the "gist" scope. When set, the dev server signs you in with
# it directly (skipping GitHub OAuth). It's always stripped from production builds.
BUN_PUBLIC_GITHUB_TOKEN=
